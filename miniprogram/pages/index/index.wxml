<view class="page">
  <view class="top">
    <view>
      <view class="kicker">ATELIER</view>
      <view class="title">沐金珠宝</view>
    </view>
    <navigator url="/pages/admin/admin" class="link">商户入口</navigator>
  </view>
  <view class="hint">项链 · 戒指 · 耳环，可整套或单件租赁 / 买断。仅公开租金与档期。</view>
  <scroll-view class="chips" scroll-x enable-flex>
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="chip {{filter === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onFilter"
    >{{item.label}}</view>
  </scroll-view>
  <view class="grid">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="card"
      data-id="{{item.id}}"
      bindtap="openDetail"
    >
      <image class="thumb" src="{{item.image}}" mode="aspectFill" />
      <view class="badge">{{item.typeLabel}} · {{item.statusLabel}}</view>
      <view class="card-body">
        <view class="name">{{item.name}}</view>
        <view class="meta">
          <text class="price">¥{{item.rentPrice}} / {{item.unitLabel}}</text>
          <text class="{{item.status === 'idle' ? 'idle' : 'rented'}}">{{item.statusLabel}}</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{!list.length}}" class="hint">该分类暂无上架商品。</view>
</view>
